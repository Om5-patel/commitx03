# ============================================================
# CommitX — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# ALL services use free tiers.

# Supabase (Free Tier — https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Test Mode = Free — https://razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# OpenRouter API (100% Free Models Chain — https://openrouter.ai/keys)
OPENROUTER_API_KEY=


# Gmail SMTP (Free — use App Password from https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@commitx.in

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=Parthgholap18@gmail.com
ADMIN_SECRET_KEY=change-me-to-a-random-secret
CRON_SECRET=change-me-to-a-random-cron-secret
